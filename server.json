{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ethanhamilthon/yenflow",
  "title": "yenflow",
  "description": "Stateless MCP server for Google Flow: Veo video and Imagen generation",
  "version": "0.75.0",
  "websiteUrl": "https://github.com/ethanhamilthon/yenflow",
  "repository": {
    "url": "https://github.com/ethanhamilthon/yenflow",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "yenflow",
      "version": "0.75.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "run"
        }
      ],
      "environmentVariables": [
        {
          "name": "GFLOW_CLI_HOME",
          "description": "Where yenflow keeps its Chrome profile and config. Defaults to a per-user directory.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
